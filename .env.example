# Порт приложения
PORT=3000

# Адрес фронтенда для CORS
FRONTEND_URL=http://localhost:3001

# PostgreSQL. При запуске приложения внутри Docker Compose DB_HOST и DB_PORT подменяются на db и 5432
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=wellness_shop

# Порт базы на хосте (доступен только с localhost). Меняй, если 5432 занят другим проектом.
# Для запуска приложения вне Docker DB_PORT должен совпадать с этим значением
DB_HOST_PORT=5432
